{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "src/server.ts": {
      "maxDuration": 60,
      "includeFiles": "knowledge/**"
    },
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "knowledge/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
