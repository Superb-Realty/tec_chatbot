# ============================================================================
# THE EASTERN CHAMBERS — AI SALES CHATBOT BACKEND CONFIGURATION
# ============================================================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Allowed Frontend Origins (comma-separated for CORS)
# Add your production domain here when deploying (e.g., https://theeasternchambers.com)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# 1. SUPABASE CLOUD DATABASE & PGVECTOR (Production Cloud Storage)
# Run `supabase/migrations/001_init_chatbot_rag_and_leads.sql` in Supabase SQL Editor
# ============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# 2. OPENAI CONFIGURATION (RAG Embeddings + Conversational Sales Agent)
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# 3. CONCURRENCY & RATE LIMITING (Tuned for 500+ Concurrent Users)
# ============================================================================
MAX_CONCURRENT_STREAMS=600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES_PER_IP=35

# ============================================================================
# 4. GOOGLE SHEETS CRM WEBHOOK (Optional Secondary Sync alongside Supabase)
# ============================================================================
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbxTW9Aeh46lHvDCKNlOcvUXEuMaGv064CyqgcG85LKkujGR_lFGQgPY413VZwj1PqA/exec"
ENQUIRY_SECRET_TOKEN="tec_leasing_key_2026"
